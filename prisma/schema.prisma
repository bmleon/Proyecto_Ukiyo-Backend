generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // <-- Con esto Prisma usará el puerto 5432 para las migraciones y no se quedará colgado
}

// =============================================================================
// 1. CONFIGURACIÓN DEL SISTEMA Y CIBERSEGURIDAD
// =============================================================================

model configuracion_sistema {
  id                   Int       @id @default(autoincrement())
  redsys_comercio      String?   @db.VarChar(255)
  redsys_terminal      String?   @default("1") @db.VarChar(50)
  redsys_clave_cifrada String?
  redsys_iv            String?   @db.VarChar(255)
  actualizado_en       DateTime? @default(now()) @db.Timestamptz(6)
}

// =============================================================================
// 2. ENTORNO DE USUARIOS, CONTROL DE ACCESO Y AUDITORÍA
// =============================================================================

model usuarios {
  id               Int                @id @default(autoincrement())
  nombre           String             @unique @db.VarChar(100)
  apellidos        String?            @db.VarChar(150)
  email            String             @unique @db.VarChar(150000)
  password         String             @db.VarChar(255)
  rol              String?            @default("USER") @db.VarChar(50)
  telefono         String?            @db.VarChar(20)
  direccion        String?            @db.Text
  creado_en        DateTime?          @default(now()) @db.Timestamptz(6)
  catering_pedidos catering_pedidos[]
  pedidos          pedidos[]
  accesos          accesos[]
}

model accesos {
  id        Int       @id @default(autoincrement())
  userId    Int
  ipOrigen  String    @db.VarChar(100)
  resultado String    @db.VarChar(50) // 'EXITO', 'FALLO_PASS'
  fechaHora DateTime? @default(now()) @db.Timestamptz(6)
  user      usuarios  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model empleados {
  id        Int       @id @default(autoincrement())
  nombre    String    @db.VarChar(100)
  cargo     String    @db.VarChar(100) // 'Cocinero', 'Repartidor', 'Camarero', etc.
  telefono  String?   @db.VarChar(20)
  creado_en DateTime? @default(now()) @db.Timestamptz(6)
}

// =============================================================================
// 3. CARTA, MENÚ, ALÉRGENOS Y OFERTAS
// =============================================================================

model categorias {
  id        Int       @id @default(autoincrement())
  nombre    String    @unique @db.VarChar(100)
  creado_en DateTime? @default(now()) @db.Timestamptz(6)
  platos    platos[]
}

model alergenos {
  id              Int               @id @default(autoincrement())
  nombre          String            @unique @db.VarChar(100)
  icono_url       String?           @db.VarChar(255)
  plato_alergenos plato_alergenos[]
}

model platos {
  id                 Int                  @id @default(autoincrement())
  nombre             String               @db.VarChar(150)
  descripcion        String?
  precio             Decimal              @db.Decimal(10, 2)
  imagen_url         String?              @db.VarChar(255)
  disponible         Boolean?             @default(true)
  categoria_id       Int?
  creado_en          DateTime?            @default(now()) @db.Timestamptz(6)
  catering_detalles  catering_detalles[]
  composicion_platos composicion_platos[]
  detalle_pedidos    detalle_pedidos[]
  plato_alergenos    plato_alergenos[]
  categorias         categorias?          @relation(fields: [categoria_id], references: [id], onUpdate: NoAction)
  ofertas            ofertas[]            // Relación añadida para conectar las promociones
}

model plato_alergenos {
  plato_id    Int
  alergeno_id Int
  alergenos   alergenos @relation(fields: [alergeno_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  platos      platos    @relation(fields: [plato_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([plato_id, alergeno_id])
}

model ofertas {
  id              Int       @id @default(autoincrement())
  nombre          String    @db.VarChar(100)        // Ej: "Descuento de Primavera", "Promo Lunes"
  descripcion     String?   @db.Text
  porcentaje_desc Decimal   @db.Decimal(5, 2)       // Ej: 15.00 (para un 15% de descuento)
  fecha_inicio    DateTime  @db.Timestamptz(6)
  fecha_fin       DateTime  @db.Timestamptz(6)
  activo          Boolean   @default(true)
  creado_en       DateTime? @default(now()) @db.Timestamptz(6)
  plato_id        Int
  platos          platos    @relation(fields: [plato_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

// =============================================================================
// 4. GESTIÓN DE INVENTARIO Y RECETAS (BEBIDAS Y MATERIAS PRIMAS)
// =============================================================================

model inventario {
  id                 Int                  @id @default(autoincrement())
  nombre             String               @unique @db.VarChar(150)
  stock_actual       Decimal              @default(0.00) @db.Decimal(10, 2)
  stock_minimo       Decimal              @default(1.00) @db.Decimal(10, 2)
  unidad_medida      String               @default("unidades") @db.VarChar(20)
  actualizado_en     DateTime?            @default(now()) @db.Timestamptz(6)
  composicion_platos composicion_platos[]
}

model composicion_platos {
  plato_id           Int
  insumo_id          Int
  cantidad_necesaria Decimal    @db.Decimal(10, 2)
  inventario         inventario @relation(fields: [insumo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  platos             platos     @relation(fields: [plato_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([plato_id, insumo_id])
}

// =============================================================================
// 5. PEDIDOS DEL RESTAURANTE (DÍA A DÍA)
// =============================================================================

model pedidos {
  id               Int               @id @default(autoincrement())
  usuario_id       Int?
  cliente_nombre   String            @db.VarChar(150)
  cliente_telefono String            @db.VarChar(20)
  cliente_email    String            @db.VarChar(150000)
  total            Decimal           @db.Decimal(10, 2)
  estado_pago      String?           @default("PENDIENTE") @db.VarChar(50)
  estado_pedido    String?           @default("PENDIENTE") @db.VarChar(50) // PENDIENTE, EN_PREPARACION, EN_REPARTO, ENTREGADO, CANCELADO
  redsys_order_id  String?           @unique @db.VarChar(50)
  creado_en        DateTime?         @default(now()) @db.Timestamptz(6)
  detalle_pedidos  detalle_pedidos[]
  usuarios         usuarios?         @relation(fields: [usuario_id], references: [id], onUpdate: NoAction)
}

model detalle_pedidos {
  id              Int      @id @default(autoincrement())
  pedido_id       Int?
  plato_id        Int?
  cantidad        Int
  precio_unitario Decimal  @db.Decimal(10, 2)
  pedidos         pedidos? @relation(fields: [pedido_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  platos          platos?  @relation(fields: [plato_id], references: [id], onUpdate: NoAction)
}

// =============================================================================
// 6. MÓDULO DE SERVICIOS DE CATERING (EVENTOS)
// =============================================================================

model catering_pedidos {
  id                   Int                 @id @default(autoincrement())
  usuario_id           Int?
  cliente_nombre       String              @db.VarChar(150)
  cliente_telefono     String              @db.VarChar(20)
  cliente_email        String              @db.VarChar(150000)
  fecha_evento         DateTime            @db.Timestamptz(6)
  numero_comensales    Int
  detalles_evento      String?
  presupuesto_estimado Decimal             @db.Decimal(10, 2)
  estado_reserva       String?             @default("SOLICITADO") @db.VarChar(50)
  estado_pago          String?             @default("PENDIENTE") @db.VarChar(50)
  redsys_order_id      String?             @unique @db.VarChar(50)
  creado_en            DateTime?           @default(now()) @db.Timestamptz(6)
  catering_detalles    catering_detalles[]
  usuarios             usuarios?           @relation(fields: [usuario_id], references: [id], onUpdate: NoAction)
}

model catering_detalles {
  id                      Int               @id @default(autoincrement())
  catering_id             Int?
  plato_id                Int?
  cantidad_platos         Int
  precio_unitario_pactado Decimal           @db.Decimal(10, 2)
  notes_plato             String?           @map("notas_plato") // Se mantiene consistente con tu base de datos postgres
  creado_en               DateTime?         @default(now()) @db.Timestamptz(6)
  catering_pedidos        catering_pedidos? @relation(fields: [catering_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  platos                  platos?           @relation(fields: [plato_id], references: [id], onUpdate: NoAction)
}